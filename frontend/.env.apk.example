# Variables para compilar el frontend que va DENTRO de la APK.
# Copiar a .env.production.local (no se versiona) antes de `npm run build`.
#
# Servidor público con HTTPS. Android bloquea HTTP sin cifrar por defecto, y la
# API maneja contraseñas y comprobantes de pago: no usar http:// aquí.
REACT_APP_SERVIDOR=https://CAMBIAR-POR-EL-DOMINIO
