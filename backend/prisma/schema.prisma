// Schema de Base de Datos - Total Clean Car (sistema de lavado de vehículos)
// Dominio: estacionamientos, reservas de lavado, agenda con bloqueo de franjas
// Roles: admin | operador | lavador | cliente
// Operación nacional por ciudades (ver model Ciudad)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USUARIOS Y CLIENTES ====================

model Usuario {
  id         Int      @id @default(autoincrement())
  username   String   @unique
  password   String
  rol        String   @default("cliente") // admin | operador | lavador | cliente
  id_cliente Int?     @unique
  id_lavador Int?     @unique
  // Solo para operadores: la ciudad que atienden. null = alcance nacional (el
  // admin siempre lo tiene). Ver utils/alcance.js.
  id_ciudad  Int?
  estado     String   @default("activo")
  createdAt  DateTime @default(now())

  cliente  Cliente?       @relation(fields: [id_cliente], references: [id])
  lavador  Lavador?       @relation(fields: [id_lavador], references: [id])
  ciudad   Ciudad?        @relation(fields: [id_ciudad], references: [id])
  sesiones RefreshToken[]
}

// Sesión viva de un usuario (ver services/sesion.service.js).
//
// El token de acceso (JWT) dura minutos y no se guarda en ningún lado: se
// verifica con la firma. Este otro es opaco, dura días y es el que permite pedir
// un acceso nuevo sin volver a escribir la contraseña. Se guarda solo su hash:
// si alguien lee la tabla no se lleva sesiones usables.
//
// `familia` encadena las rotaciones de un mismo inicio de sesión. En cada uso el
// token se revoca y se emite otro de la misma familia; si llega uno ya revocado
// significa que alguien está reusando una copia robada, y se corta la familia
// entera (la víctima y el atacante quedan afuera, y la víctima vuelve a entrar).
model RefreshToken {
  id         Int      @id @default(autoincrement())
  token_hash String   @unique // SHA-256 del token entregado al cliente
  id_usuario Int
  familia    String
  expira     DateTime
  revocado   Boolean  @default(false)
  createdAt  DateTime @default(now())

  usuario Usuario @relation(fields: [id_usuario], references: [id], onDelete: Cascade)

  @@index([id_usuario])
  @@index([familia])
  @@index([expira])
}

model Cliente {
  id        Int       @id @default(autoincrement())
  nombre    String
  cedula    String?   @unique
  telefono  String?
  email     String?   @unique
  estado    String    @default("activo")
  createdAt DateTime  @default(now())

  usuario  Usuario?
  vehiculos Vehiculo[]
  reservas  Reserva[]
}

model Vehiculo {
  id         Int     @id @default(autoincrement())
  id_cliente Int
  placa      String  @unique
  marca      String?
  modelo     String?
  color      String?
  // Define qué servicios puede contratar y a qué precio (ver PrecioServicio).
  // Nullable solo por los vehículos anteriores al catálogo: sin tipo no se reserva.
  id_tipo_vehiculo Int?
  estado     String  @default("activo")

  cliente      Cliente       @relation(fields: [id_cliente], references: [id])
  tipoVehiculo TipoVehiculo? @relation(fields: [id_tipo_vehiculo], references: [id])
  reservas     Reserva[]

  @@index([id_cliente])
}

// Catálogo de tipos de vehículo (moto, liviano, SUV...). Como las salas de un
// cine (2D, 3D, IMAX): el mismo servicio cambia de precio y duración según el tipo.
model TipoVehiculo {
  id            Int     @id @default(autoincrement())
  codigo        String  @unique // moto | liviano | suv | camioneta
  nombre        String
  descripcion   String?
  orden_display Int     @default(0)
  activo        Boolean @default(true)

  vehiculos Vehiculo[]
  precios   PrecioServicio[]
}

// ==================== CIUDADES ====================

// La operación es nacional y se organiza por ciudad: cada sitio, lavador y
// operador pertenece a una. La agenda nunca mezcla ciudades: un lavador de
// Guayaquil no abre cupos en Quito ni una bahía de un taller atiende al otro.
model Ciudad {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  provincia String?
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())

  estacionamientos Estacionamiento[]
  lavadores        Lavador[]
  usuarios         Usuario[]
  bloqueos         AsignacionAgenda[]
}

// ==================== SITIOS Y ESPACIOS ====================

model Estacionamiento {
  id               Int     @id @default(autoincrement())
  nombre           String
  direccion        String?
  id_ciudad        Int
  // aliado = edificio/condominio/oficina donde se hace el expreso;
  // taller = tiene las bahías de la limpieza profunda de su ciudad.
  tipo             String  @default("aliado")
  contacto         String?
  horario_apertura String  @default("07:00")
  horario_cierre   String  @default("18:00")
  admite_expreso   Boolean @default(true)
  // Configuración de agenda por sitio:
  // capacidad_expreso = lavados simultáneos en este sitio (0 = usar lavadores activos globales)
  capacidad_expreso   Int @default(0)
  // duracion_franja_min = granularidad de la grilla de horas (0/30/60; default global 60)
  duracion_franja_min Int @default(60)
  estado           String  @default("activo")

  ciudad        Ciudad             @relation(fields: [id_ciudad], references: [id])
  plazas        Plaza[]
  reservas      Reserva[]
  suscripciones Suscripcion[]
  bloqueos      AsignacionAgenda[]

  @@index([id_ciudad])
}

// ==================== PLANES PARA EDIFICIOS/CONDOMINIOS ====================
// El plan se contrata para un estacionamiento (edificio/condominio): cubre
// N lavados expreso al mes compartidos entre todos los residentes que reservan ahí.
model Plan {
  id                Int      @id @default(autoincrement())
  nombre            String
  descripcion       String?
  precio_mensual    Float
  lavados_incluidos Int // total del sitio, por mes
  modalidad         String   @default("expreso") // expreso | profunda
  estado            String   @default("activo")
  createdAt         DateTime @default(now())

  suscripciones Suscripcion[]
}

model Suscripcion {
  id                 Int       @id @default(autoincrement())
  id_estacionamiento Int
  id_plan            Int
  fecha_inicio       DateTime  @default(now())
  fecha_cancelacion  DateTime?
  estado             String    @default("activa") // activa | cancelada

  estacionamiento Estacionamiento @relation(fields: [id_estacionamiento], references: [id])
  plan            Plan            @relation(fields: [id_plan], references: [id])
  reservas        Reserva[]

  @@index([id_estacionamiento])
}

model Plaza {
  id                 Int     @id @default(autoincrement())
  id_estacionamiento Int
  codigo             String // "P-01", "B-01"...
  tipo               String  @default("estacionamiento") // estacionamiento | bahia_lavado
  estado             String  @default("disponible") // disponible | ocupada | mantenimiento

  estacionamiento Estacionamiento @relation(fields: [id_estacionamiento], references: [id])
  reservas        Reserva[]

  @@unique([id_estacionamiento, codigo])
}

// ==================== CATÁLOGO DE SERVICIOS ====================

// El precio y la duración NO viven aquí sino en PrecioServicio, uno por tipo de
// vehículo. Un servicio sin fila para un tipo no se ofrece a ese tipo.
model TipoServicio {
  id            Int     @id @default(autoincrement())
  nombre        String
  descripcion   String?
  modalidad     String // expreso | profunda
  activo        Boolean @default(true)
  orden_display Int     @default(0)

  reservas Reserva[]
  precios  PrecioServicio[]
}

model PrecioServicio {
  id               Int     @id @default(autoincrement())
  id_tipo_servicio Int
  id_tipo_vehiculo Int
  precio           Float
  duracion_min     Int
  activo           Boolean @default(true)

  tipoServicio TipoServicio @relation(fields: [id_tipo_servicio], references: [id])
  tipoVehiculo TipoVehiculo @relation(fields: [id_tipo_vehiculo], references: [id])

  @@unique([id_tipo_servicio, id_tipo_vehiculo])
}

// Extras que se suman al servicio principal (la "confitería" del cine):
// encerado, aromatizante, limpieza de motor... Suman precio y tiempo.
model ServicioAdicional {
  id            Int     @id @default(autoincrement())
  nombre        String
  descripcion   String?
  precio        Float
  duracion_min  Int     @default(0) // minutos que agrega a la franja
  activo        Boolean @default(true)
  orden_display Int     @default(0)

  reservas ReservaAdicional[]
}

// Adicionales contratados en una reserva. Nombre, precio y duración se copian
// al reservar: cambiar el catálogo después no altera reservas ya hechas.
model ReservaAdicional {
  id           Int    @id @default(autoincrement())
  id_reserva   Int
  id_adicional Int
  nombre       String
  precio       Float
  duracion_min Int

  reserva   Reserva           @relation(fields: [id_reserva], references: [id])
  adicional ServicioAdicional @relation(fields: [id_adicional], references: [id])

  @@unique([id_reserva, id_adicional])
}

// ==================== PERSONAL ====================

model Lavador {
  id      Int     @id @default(autoincrement())
  nombre  String
  cedula  String? @unique
  telefono String?
  // Ciudad donde trabaja: suma capacidad expreso solo en los sitios de ella y
  // solo se le asignan reservas de ella.
  id_ciudad Int
  estado  String  @default("activo")

  ciudad       Ciudad             @relation(fields: [id_ciudad], references: [id])
  usuario      Usuario?
  asignaciones AsignacionAgenda[]

  @@index([id_ciudad])
}

// ==================== NÚCLEO OPERATIVO ====================

// Estados: solicitada → confirmada → en_proceso → completada | cancelada | no_asistio
model Reserva {
  id                 Int      @id @default(autoincrement())
  codigo             String   @unique // RES-2026-00001
  id_cliente         Int
  id_vehiculo        Int
  id_tipo_servicio   Int
  id_estacionamiento Int?
  id_plaza           Int?
  id_suscripcion     Int?
  modalidad          String // expreso | profunda
  fecha              DateTime
  hora_inicio        String // "09:00"
  hora_fin           String // "10:30"
  estado             String   @default("solicitada")
  observaciones      String?
  // Total a cobrar: precio del servicio para el tipo de vehículo (0 si lo cubre
  // un plan) + adicionales. El desglose de adicionales está en ReservaAdicional.
  precio_final       Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  cliente         Cliente            @relation(fields: [id_cliente], references: [id])
  vehiculo        Vehiculo           @relation(fields: [id_vehiculo], references: [id])
  tipoServicio    TipoServicio       @relation(fields: [id_tipo_servicio], references: [id])
  estacionamiento Estacionamiento?   @relation(fields: [id_estacionamiento], references: [id])
  plaza           Plaza?             @relation(fields: [id_plaza], references: [id])
  suscripcion     Suscripcion?       @relation(fields: [id_suscripcion], references: [id])
  asignaciones    AsignacionAgenda[]
  registro        RegistroLavado?
  pagos           Pago[]
  historial       HistorialReserva[]
  calificacion    Calificacion?
  adicionales     ReservaAdicional[]

  @@index([fecha])
  @@index([estado])
  @@index([id_cliente])
  @@index([id_estacionamiento])
}

// AGENDA: cada fila = franja ocupada. La disponibilidad se calcula
// contando filas solapadas vs capacidad (lavadores o bahías).
// id_reserva null + nota = bloqueo manual (mantiene, imprevistos). El alcance
// del bloqueo lo dan id_estacionamiento (un sitio) o id_ciudad (toda la
// ciudad); sin ninguno de los dos es nacional (un feriado, por ejemplo).
model AsignacionAgenda {
  id          Int      @id @default(autoincrement())
  id_reserva  Int?
  id_lavador  Int?
  id_ciudad   Int?
  id_estacionamiento Int?
  fecha       DateTime
  hora_inicio String
  hora_fin    String
  estado      String   @default("pendiente") // pendiente | en_proceso | completado | cancelado
  nota        String?

  reserva Reserva? @relation(fields: [id_reserva], references: [id])
  lavador Lavador? @relation(fields: [id_lavador], references: [id])
  ciudad  Ciudad?  @relation(fields: [id_ciudad], references: [id])
  estacionamiento Estacionamiento? @relation(fields: [id_estacionamiento], references: [id])

  @@index([fecha])
  @@index([id_lavador])
}

// Evidencia del trabajo
model RegistroLavado {
  id             Int       @id @default(autoincrement())
  id_reserva     Int       @unique
  checklist      Json?
  fotos_antes    String?
  fotos_despues  String?
  observaciones  String?
  fecha_fin      DateTime?
  createdAt      DateTime  @default(now())

  reserva Reserva @relation(fields: [id_reserva], references: [id])
}

// MAPEO PARA PAGOS FUTUROS (pasarela en Fase 3)
model Pago {
  id         Int       @id @default(autoincrement())
  id_reserva Int
  monto      Float
  metodo     String    @default("efectivo") // efectivo | transferencia | tarjeta
  // en_verificacion = comprobante subido por el cliente, esperando que un
  // operador lo apruebe; NO cuenta como ingreso hasta ser aprobado
  estado     String    @default("pendiente") // pendiente | en_verificacion | aprobado | rechazado | reembolsado
  referencia String? // id transacción pasarela
  // Comprobante de transferencia adjuntado por el operador (imagen o PDF).
  // Se sirve firmado desde /uploads/comprobantes/, ver utils/firmaArchivos.js
  comprobante_url String?
  fecha_pago DateTime?
  createdAt  DateTime  @default(now())

  reserva Reserva @relation(fields: [id_reserva], references: [id])

  @@index([estado])
}

// Auditoría de cambios de la reserva
model HistorialReserva {
  id              Int      @id @default(autoincrement())
  id_reserva      Int
  accion          String
  estado_anterior String?
  estado_nuevo    String?
  motivo          String?
  usuario         String?
  fecha_cambio    DateTime @default(now())

  reserva Reserva @relation(fields: [id_reserva], references: [id])

  @@index([id_reserva])
}

// Calificación del cliente sobre el lavado (post-completado)
model Calificacion {
  id         Int      @id @default(autoincrement())
  id_reserva Int      @unique
  id_cliente Int
  puntuacion Int // 1-5
  comentario String?
  createdAt  DateTime @default(now())

  reserva Reserva @relation(fields: [id_reserva], references: [id])

  @@index([id_cliente])
}
