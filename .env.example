# ==================== CONFIGURACION DOCKER ====================
# Sistema de Lavado de Carros

# PostgreSQL
POSTGRES_USER=lavado_user
POSTGRES_PASSWORD=Lavado2026
POSTGRES_DB=lavado_db

# Backend
DATABASE_URL=postgresql://lavado_user:Lavado2026@postgres:5432/lavado_db
JWT_SECRET=lavado-carros-secret-key-cambiar-en-produccion
JWT_EXPIRES_IN=24h
PORT=3042
NODE_ENV=production

# Email (notificaciones al cliente). Vacío = los correos solo se registran en el log.
# Ejemplo Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=tu@gmail.com, SMTP_PASS=contraseña de aplicación
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Lavado de Carros <no-reply@lavadocarros.local>

# WhatsApp/SMS (recordatorios). Vacío = los mensajes solo se registran en el log.
# Twilio: TWILIO_WHATSAPP_FROM ej. whatsapp:+14155238886 (sandbox); TWILIO_SMS_FROM ej. +1234567890
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
